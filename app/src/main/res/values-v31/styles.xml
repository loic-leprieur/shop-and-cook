<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ shows its own mandatory splash screen (using the app icon) before any
         activity draws. Without this, that OS splash shows the launcher icon, then our own
         SplashActivity shows the full logo right after - looking like two different logos.
         Neutralizing the OS splash to a blank white screen makes the full logo the only
         one the user actually perceives. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/white</item>
    </style>
</resources>
